<?xml version="1.0"?>

<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="j2n6s300_control">
    <ros2_control name="j2n6s300" type="system">
      <joint name="j2n6s300_joint_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="j2n6s300_joint_2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="j2n6s300_joint_3">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="j2n6s300_joint_4">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="j2n6s300_joint_5">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="j2n6s300_joint_6">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <hardware>
        <plugin>kinova_driver/KinovaSystemHardware</plugin>
        <!-- Optional; defaults shown. See kinova_system_hardware.hpp. -->
        <!-- <param name="serial_number"></param> -->
        <param name="position_kp">5.0</param>
        <param name="max_joint_velocity_deg">100.0</param>
        <param name="io_rate_hz">100</param>
        <param name="command_timeout_ms">100</param>
        <param name="max_consecutive_io_errors">10</param>
      </hardware>
    </ros2_control>
  </xacro:macro>
</robot>
