<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kinova_driver</name>
  <version>0.0.1</version>
  <description>Driver package for the Kinova Gen2 Jaco Arm</description>
  <maintainer email="enderman9523@gmail.com">cam</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp_lifecycle</depend>
  <!-- Runtime dependency of the vendored USBCommLayerUbuntu.so -->
  <exec_depend>libusb-1.0</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>