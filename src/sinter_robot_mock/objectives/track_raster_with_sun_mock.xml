<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Track Raster With Sun Mock">
  <BehaviorTree
    ID="Track Raster With Sun Mock"
    _description="Step 1 of docs/continuous_tracking_plan.md, simulation only. Moves to BeforeSinter, puts the simulated sun just off the sun camera's axis, then switches to velocity_force_controller and runs TrackRasterWithSun: the focal point follows a 3-line zig-zag (30 mm lines, 4 mm apart, in the plane square to the lens axis) at scan_speed_mps while the lens continuously pulls the sun onto its axis. Switches back to the trajectory controller afterwards, also on failure. Watch /sinter/sun_error_stream (pointing error, rad in z), /sinter/track_error and /sinter/track_progress."
    _favorite="true"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <Action
        ID="Script"
        code="scan_speed_mps := 0.0005; gain_rot := 0.5; gain_pos := 1.0; max_tracking_error_m := 0.003; min_dexterity := 0.005; gain_roll := 0.025"
      />
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        waypoint_name="BeforeSinter"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.0"
        seed="0"
        velocity_scale_factor="0.5"
      />
      <SubTree ID="Reset Sun To Camera" _collapsed="true" />
      <Action ID="WaitForDuration" delay_duration="1.0" />
      <Control
        ID="Sequence"
        name="Test path in the focal frame (fixed in world when tracking starts)"
      >
        <Action ID="ResetPoseStampedVector" vector="{track_path}" />
        <Action
          ID="CreatePoseStamped"
          reference_frame="ee_focal_point_link"
          position_xyz="0;0;0"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{pt}"
        />
        <Action
          ID="AddPoseStampedToVector"
          input="{pt}"
          vector="{track_path}"
        />
        <Action
          ID="CreatePoseStamped"
          reference_frame="ee_focal_point_link"
          position_xyz="0.03;0;0"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{pt}"
        />
        <Action
          ID="AddPoseStampedToVector"
          input="{pt}"
          vector="{track_path}"
        />
        <Action
          ID="CreatePoseStamped"
          reference_frame="ee_focal_point_link"
          position_xyz="0.03;0.004;0"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{pt}"
        />
        <Action
          ID="AddPoseStampedToVector"
          input="{pt}"
          vector="{track_path}"
        />
        <Action
          ID="CreatePoseStamped"
          reference_frame="ee_focal_point_link"
          position_xyz="0;0.004;0"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{pt}"
        />
        <Action
          ID="AddPoseStampedToVector"
          input="{pt}"
          vector="{track_path}"
        />
        <Action
          ID="CreatePoseStamped"
          reference_frame="ee_focal_point_link"
          position_xyz="0;0.008;0"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{pt}"
        />
        <Action
          ID="AddPoseStampedToVector"
          input="{pt}"
          vector="{track_path}"
        />
        <Action
          ID="CreatePoseStamped"
          reference_frame="ee_focal_point_link"
          position_xyz="0.03;0.008;0"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{pt}"
        />
        <Action
          ID="AddPoseStampedToVector"
          input="{pt}"
          vector="{track_path}"
        />
        <Action ID="VisualizePath" path="{track_path}" show_poses="false" />
      </Control>
      <Action
        ID="SwitchController"
        activate_asap="true"
        automatic_deactivation="true"
        controller_list_action_name="/controller_manager/list_controllers"
        controller_switch_action_name="/controller_manager/switch_controller"
        strictness="2"
        timeout="1000.0"
        activate_controllers="velocity_force_controller"
      />
      <Control ID="Fallback" name="Track, or switch back and fail">
        <Action
          ID="TrackRasterWithSun"
          sun_feedforward="true"
          latitude_deg="39.7555"
          north_heading_deg="125.0"
          sun_feedforward_scale="1.0"
          path="{track_path}"
          scan_speed_mps="{scan_speed_mps}"
          gain_rot="{gain_rot}"
          gain_pos="{gain_pos}"
          max_tracking_error_m="{max_tracking_error_m}"
          image_topic="/camera/image_raw"
          camera_info_topic="/camera/camera_info"
          command_topic="/velocity_force_controller/command"
          world_frame="world"
          focal_frame="ee_focal_point_link"
          rate_hz="50.0"
          max_linear_mps="0.01"
          max_angular_rps="0.02"
          max_pointing_error_rad="0.0175"
          sun_timeout_s="0.5"
          sun_lost_abort_s="0.0"
          start_tolerance_m="0.005"
          finish_tolerance_m="0.0005"
          aim_offset_x_rad="0.0"
          aim_offset_y_rad="0.0"
          min_dexterity="{min_dexterity}"
          gain_roll="{gain_roll}"
          max_roll_rate_rps="0.01"
          lift_speed_mps="0.003"
        />
        <Control ID="Sequence" name="Recover">
          <Action
            ID="SwitchController"
            activate_asap="true"
            automatic_deactivation="true"
            controller_list_action_name="/controller_manager/list_controllers"
            controller_switch_action_name="/controller_manager/switch_controller"
            strictness="2"
            timeout="1000.0"
            activate_controllers="joint_trajectory_admittance_controller"
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
      <Action
        ID="SwitchController"
        activate_asap="true"
        automatic_deactivation="true"
        controller_list_action_name="/controller_manager/list_controllers"
        controller_switch_action_name="/controller_manager/switch_controller"
        strictness="2"
        timeout="1000.0"
        activate_controllers="joint_trajectory_admittance_controller"
      />
      <Action
        ID="LogMessage"
        message="Track Raster With Sun Mock: path complete, trajectory controller restored."
        log_level="info"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Track Raster With Sun Mock">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Continuous Tracking" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
