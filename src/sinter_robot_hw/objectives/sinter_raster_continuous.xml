<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Sinter Raster Continuous">
  <BehaviorTree
    ID="Sinter Raster Continuous"
    _description="Continuous sintering raster for the real system (docs/continuous_tracking_plan.md). Scans the bed with the RealSense, crops and plane-fits it, and plans a zig-zag raster on the surface; seeds the lens from the ephemeris and aligns it to the sun about the focal point; checks with IK that one lens orientation reaches the whole raster; makes a planned, collision-checked lead-in to the first raster point; then switches to velocity_force_controller and runs TrackRasterWithSun, which moves the focal point along the raster at scan_speed_mps while continuously holding the lens on the sun (pauses if the sun is hidden and resumes). Switches back to the trajectory controller and retreats to BeforeSinter and Scan_Initial afterwards. On any failure during the scan it sends a zero twist, switches back and retreats. If you stop it from the UI, run Switch To Trajectory Controller before planning any other move."
    _favorite="true"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!--Planned moves need the trajectory controller; a run stopped from the UI leaves the velocity controller active. Harmless if it is already active.-->
      <SubTree ID="Switch To Trajectory Controller" _collapsed="true" />
      <!--Tunable parameters. scan_speed_mps is the scan speed V along the raster in m/s (R5: 0.5-1.5 mm/s). gain_rot (1/s) is the sun-pointing loop gain and gain_pos (1/s) the path-tracking gain; steady pointing lag = sun rate / gain_rot (0.004 deg/s / 0.5 = 0.008 deg). max_tracking_error_m and max_pointing_error_rad abort the scan (zero twist, retreat). sun_lost_abort_s = 0 pauses as long as the sun is hidden (clouds) and resumes when it is back. raster_size_m: the raster is a square of this side centred on the fitted plane; the crop box must land on the bed and be a little larger than the square (the fit fails if the measured surface does not cover it); 0 = fill the crop. lift_m: whenever the sun is not locked (start, clouds) and before any stop, the focus is held this far off the bed along the lens axis so the spot never dwells focused on one point. Singularity handling: dexterity is the distance from singularity (0 = singular .. 1). The roll with the best worst-point dexterity is chosen; min_roll_dexterity aborts before the lead-in if even that is too low, min_dexterity aborts the scan if the arm gets that close to a singularity, and gain_roll > 0 (try 0.05) lets the lens roll about its axis during the scan to climb away from singularities (does not move the focus or the sun alignment). outlier_distance_m drops depth points farther than that from the fitted plane (sun glare noise). settle_time_s is the pause after each move before a sun camera frame is grabbed, so the image shows the new pose (camera latency + arm vibration). north_heading_deg is the direction of true north in world, CCW from +X (125 as of 2026-11-03: world +X points ~SE at true bearing 125 deg, +Y ~NE at 35 deg. It describes how the robot base is turned relative to true north, so re-measure it whenever the robot is rotated; it does not change with the sun. Copies to keep in sync: additional_driver_nodes.launch.py (sun_ephemeris node), the Parameters scripts of sinter_raster_closed_loop.xml, sinter_raster_continuous.xml, calibrate_focus_lift.xml and sinter_dot_grid.xml, the north_heading_deg default of move_to_sun_seed_with_roll.xml, and the heading option of scripts/rs_calibration/solve.py). focus_lift_m raises the raster off the fitted plane along its normal so the focus lands on the sand (+ = up; the RealSense plane sat below the real surface, 2026-10-28). aim_offset_x_rad / aim_offset_y_rad: where the sun sits in the sun camera image (rad from center) when the lens itself is on the sun; calibrate with Calibrate Aim Offset. Set use_ephemeris_seed to false when testing with the simulated sun camera, which places the sun relative to the camera rather than the sky.-->
      <Action
        ID="Script"
        name="Parameters"
        code="line_spacing_m := 0.004; point_spacing_m := 0.0; edge_margin_m := 0.005; outlier_distance_m := 0.005; alignment_tolerance_rad := 0.002; max_align_attempts := 8; settle_time_s := 0.3; align_velocity_scale := 0.25; use_ephemeris_seed := true; focus_lift_m := -0.045; aim_offset_x_rad := 0.0; aim_offset_y_rad := 0.0; latitude_deg := 39.7555; longitude_deg := -105.2211; north_heading_deg := 125; scan_speed_mps := 0.001; gain_rot := 0.5; gain_pos := 1.0; max_tracking_error_m := 0.003; max_pointing_error_rad := 0.0175; sun_lost_abort_s := 0.0; raster_size_m := 0.04; min_roll_dexterity := 0.02; min_dexterity := 0.01; gain_roll := 0.0; lift_m := 0.03"
      />
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        waypoint_name="Scan_Initial"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.01"
        seed="0"
        velocity_scale_factor="1.0"
      />
      <SubTree ID="Clear Snapshot" _collapsed="true" />
      <!--RealSense D415 depth -> crop to X x Y + plane fit -> N waypoints, zig-zag raster, M spacing-->
      <Control ID="Sequence" name="Generate scanning waypoints">
        <Action
          ID="GetPointCloud"
          topic_name="/camera/camera/depth/color/points"
          message_out="{point_cloud_scan}"
          publisher_timeout_sec="5.000000"
        />
        <Action
          ID="TransformPointCloudFrame"
          input_cloud="{point_cloud_scan}"
          target_frame="world"
          output_cloud="{point_cloud_scan}"
        />
        <!--X x Y crop region on the surface (tune position/size for your setup). Z is tall so any surface height is kept.-->
        <Action
          ID="CreatePoseStamped"
          reference_frame="world"
          position_xyz="-0.65;0.02;0"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{crop_pose}"
        />
        <Action
          ID="CropPointsInBox"
          point_cloud="{point_cloud_scan}"
          crop_box_centroid_pose="{crop_pose}"
          crop_box_size="0.08;0.08;1.0"
          point_cloud_cropped="{point_cloud_cropped}"
        />
        <Action ID="SendPointCloudToUI" point_cloud="{point_cloud_cropped}" />
        <Action
          ID="FitPlaneRasterPath"
          point_cloud="{point_cloud_cropped}"
          line_spacing="{line_spacing_m}"
          point_spacing="{point_spacing_m}"
          edge_margin="{edge_margin_m}"
          outlier_distance="{outlier_distance_m}"
          surface_offset="{focus_lift_m}"
          path="{raster_path}"
          plane_pose="{plane_pose}"
          num_waypoints="{num_waypoints}"
          extremes="{raster_extremes}"
          line_subdivisions="2"
          raster_size_m="{raster_size_m}"
        />
        <Action ID="VisualizePath" path="{raster_path}" show_poses="true" />
        <Action ID="VisualizePose" pose="{plane_pose}" marker_name="plane" />
      </Control>
      <!--Begin sintering from BeforeSinter, close to the surface: the sun seed and alignment happen here, so the lead-in to the first raster point is short. Then the starting sun pose from the ephemeris model.-->
      <!--Via Home: Scan_Initial and BeforeSinter are ~180 deg apart on joint 6, and the direct move takes the short way through +/-180 deg, winding the wrist cables. Via Home both legs are under 180 deg and pass through 0.-->
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        _skipIf="true"
        waypoint_name="Home"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.01"
        seed="0"
        velocity_scale_factor="1.0"
      />
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        waypoint_name="BeforeSinter"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.01"
        seed="0"
        velocity_scale_factor="1.0"
      />
      <Action
        ID="WaitForDuration"
        name="WaitForDuration"
        _skipIf="true"
        delay_duration="5.000000"
      />
      <Decorator ID="Precondition" if="use_ephemeris_seed" else="SUCCESS">
        <!--Starting sun pose. The sun stays low here (under ~38 deg in late October at this latitude), so the lens tilts far over; try lens roll angles about the optical axis, nearest the current one first, and take the first that plans.-->
        <Control
          ID="Fallback"
          name="Starting sun pose (ephemeris), try lens rolls"
        >
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll 0 deg"
            _collapsed="true"
            roll_xyzw="0;0;0;1"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll 45 deg"
            _collapsed="true"
            roll_xyzw="0;0;0.382683;0.92388"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll -45 deg"
            _collapsed="true"
            roll_xyzw="0;0;-0.382683;0.92388"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll 90 deg"
            _collapsed="true"
            roll_xyzw="0;0;0.707107;0.707107"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll -90 deg"
            _collapsed="true"
            roll_xyzw="0;0;-0.707107;0.707107"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll 135 deg"
            _collapsed="true"
            roll_xyzw="0;0;0.92388;0.382683"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll -135 deg"
            _collapsed="true"
            roll_xyzw="0;0;-0.92388;0.382683"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll 180 deg"
            _collapsed="true"
            roll_xyzw="0;0;1;0"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
        </Control>
      </Decorator>
      <!--Rotate lens to align to sun about focal point; alignment error < tolerance, or abort-->
      <SubTree
        ID="Align Lens To Sun"
        _collapsed="true"
        alignment_tolerance_rad="{alignment_tolerance_rad}"
        max_align_attempts="{max_align_attempts}"
        velocity_scale_factor="{align_velocity_scale}"
        settle_time_s="{settle_time_s}"
        aim_offset_x_rad="{aim_offset_x_rad}"
        aim_offset_y_rad="{aim_offset_y_rad}"
        aligned_focal_pose="{aligned_focal_pose}"
      />
      <!--Reachability check before going near the surface: the raster keeps one lens orientation (the sun direction plus a roll about the optical axis, which does not move the focus), so find a roll for which IK solves at the raster check points (raster_extremes: both ends and the middle of every scan line, about 3 per line, so the check stays fast with many subdivisions), nearest the current roll first. That orientation becomes sun_orientation for the lead-in and the scan. If none works the sun is too low or the surface is out of reach from here (see the description), so stop with the arm still up.-->
      <Action
        ID="GetCurrentPlanningScene"
        planning_scene_msg="{planning_scene}"
      />
      <Control ID="Sequence" name="Pick the lens roll farthest from a singularity over the whole raster">
        <!--Every roll whose IK solves at all raster check points is scored by its worst point's dexterity (distance from singularity). Rolls are tried nearest the current roll first, and a farther roll only replaces the best so far if it is 25 % better (KeepBestRoll min_improvement), so the lead-in avoids big wrist rotations unless they buy a real margin. A roll that fails IK anywhere is skipped.-->
        <Action ID="Script" code="best_dexterity := -1.0" />
        <Decorator ID="ForceSuccess" name="Roll 0 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_extremes}"
              roll_xyzw="0;0;0;1"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_dexterity}"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_name="roll 0 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="ForceSuccess" name="Roll 45 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_extremes}"
              roll_xyzw="0;0;0.382683;0.92388"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_dexterity}"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_name="roll 45 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="ForceSuccess" name="Roll -45 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_extremes}"
              roll_xyzw="0;0;-0.382683;0.92388"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_dexterity}"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_name="roll -45 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="ForceSuccess" name="Roll 90 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_extremes}"
              roll_xyzw="0;0;0.707107;0.707107"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_dexterity}"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_name="roll 90 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="ForceSuccess" name="Roll -90 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_extremes}"
              roll_xyzw="0;0;-0.707107;0.707107"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_dexterity}"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_name="roll -90 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="ForceSuccess" name="Roll 135 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_extremes}"
              roll_xyzw="0;0;0.92388;0.382683"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_dexterity}"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_name="roll 135 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="ForceSuccess" name="Roll -135 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_extremes}"
              roll_xyzw="0;0;-0.92388;0.382683"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_dexterity}"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_name="roll -135 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="ForceSuccess" name="Roll 180 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_extremes}"
              roll_xyzw="0;0;1;0"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_dexterity}"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_name="roll 180 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="Precondition" if="best_dexterity &lt; 0.0" else="SUCCESS">
          <Control ID="Sequence" name="No roll reaches the raster">
            <Action ID="LogMessage" message="Sinter raster unreachable: with the lens on the sun, IK fails for at least one raster point at every lens roll. The sun is too low for this surface position; move the surface to the side of the base away from the sun, or sinter closer to solar noon." log_level="error" />
            <Action ID="AlwaysFailure" />
          </Control>
        </Decorator>
        <Decorator ID="Precondition" if="best_dexterity &lt; min_roll_dexterity" else="SUCCESS">
          <Control ID="Sequence" name="Best roll too close to a singularity">
            <Action ID="LogMessage" message="Sinter raster too close to a singularity: the best lens roll's worst raster point has dexterity below min_roll_dexterity (see the KeepBestRoll scores). Move the bed closer to the base, shrink raster_size_m, or lower min_roll_dexterity." log_level="error" />
            <Action ID="AlwaysFailure" />
          </Control>
        </Decorator>
      </Control>
      <!--Lead-in: planned, collision-checked move from the aligned pose to the first raster point, with the lens orientation the reachability check chose (sun direction + roll). Only index 0 does anything.-->
      <Decorator ID="ForEach" vector_in="{raster_path}" index="{index}" out="{waypoint}">
        <Decorator ID="Precondition" if="index == 0" else="SUCCESS">
          <Control ID="Sequence" name="Lead-in to the first raster point">
            <Action ID="UnpackPoseStampedMessage" pose_stamped="{waypoint}" header="{waypoint_header}" pose="{waypoint_pose}" />
            <Action ID="UnpackPoseMessage" pose="{waypoint_pose}" position="{waypoint_position}" />
            <Action ID="CreatePoseMessage" position="{waypoint_position}" orientation="{sun_orientation}" pose="{leadin_msg}" />
            <Action ID="CreatePoseStampedMessage" header="{waypoint_header}" pose="{leadin_msg}" pose_stamped="{leadin_target}" />
            <Action ID="VisualizePose" pose="{leadin_target}" marker_name="leadin_target" />
            <SubTree
              ID="Move to Pose"
              _collapsed="true"
              target_pose="{leadin_target}"
              ik_frame="ee_focal_point_link"
              velocity_scale_factor="{align_velocity_scale}"
              link_padding="0.01"
              controller_names="joint_trajectory_admittance_controller"
              controller_action_name="/joint_trajectory_admittance_controller/follow_joint_trajectory"
              execution_pipeline="jtac"
              planning_group_name="manipulator"
              require_user_approval="false"
              max_ik_solutions="8"
              max_mtc_solutions="0"
            />
          </Control>
        </Decorator>
      </Decorator>
      <!--Continuous scan: focal point follows the raster (3 DOF), lens tracks the sun (3 DOF). On failure: zero twist (in the behavior), trajectory controller, planned retreat, report failure.-->
      <Control ID="Fallback" name="Scan, or stop safely and retreat">
        <Control ID="Sequence" name="Continuous scan">
        <Action
          ID="SwitchController"
          activate_asap="true"
          automatic_deactivation="true"
          controller_list_action_name="/controller_manager/list_controllers"
          controller_switch_action_name="/controller_manager/switch_controller"
          strictness="2"
          timeout="1000.0"
          activate_controllers="velocity_force_controller"
        />
        <Action
          ID="TrackRasterWithSun"
          path="{raster_path}"
          scan_speed_mps="{scan_speed_mps}"
          gain_rot="{gain_rot}"
          gain_pos="{gain_pos}"
          max_tracking_error_m="{max_tracking_error_m}"
          max_pointing_error_rad="{max_pointing_error_rad}"
          sun_lost_abort_s="{sun_lost_abort_s}"
          aim_offset_x_rad="{aim_offset_x_rad}"
          aim_offset_y_rad="{aim_offset_y_rad}"
          image_topic="/camera/image_raw"
          camera_info_topic="/camera/camera_info"
          command_topic="/velocity_force_controller/command"
          world_frame="world"
          focal_frame="ee_focal_point_link"
          rate_hz="50.0"
          max_linear_mps="0.01"
          max_angular_rps="0.02"
          sun_timeout_s="0.5"
          start_tolerance_m="0.005"
          finish_tolerance_m="0.0005"
          acquire_tolerance_rad="{alignment_tolerance_rad}"
          acquire_timeout_s="0.0"
          lift_m="{lift_m}"
          lift_speed_mps="0.01"
          max_acquire_error_rad="0.15"
          finish_timeout_s="5.0"
          camera_timeout_s="3.0"
          min_dexterity="{min_dexterity}"
          gain_roll="{gain_roll}"
          max_roll_rate_rps="0.01"
          planning_group="manipulator"
          dexterity_length_m="0.4"
          start_at_m="0.0"
          progress_m="{track_progress_m}"
          path_world="{track_path_world}"
        />
        <Action
          ID="SwitchController"
          activate_asap="true"
          automatic_deactivation="true"
          controller_list_action_name="/controller_manager/list_controllers"
          controller_switch_action_name="/controller_manager/switch_controller"
          strictness="2"
          timeout="1000.0"
          activate_controllers="joint_trajectory_admittance_controller"
        />
        </Control>
        <Control ID="Sequence" name="Scan failed: stop, switch back, retreat">
          <Action ID="LogMessage" message="Sinter Raster Continuous: scan stopped early (see the TrackRasterWithSun message). Switching back to the trajectory controller and retreating to BeforeSinter." log_level="error" />
          <SubTree ID="Switch To Trajectory Controller" _collapsed="true" />
          <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        waypoint_name="BeforeSinter"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.01"
        seed="0"
        velocity_scale_factor="{align_velocity_scale}"
      />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
      <!--Retreat off the surface, then home to Scan_Initial (via Home so joint 6 does not pass through +/-180 deg).-->
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        waypoint_name="BeforeSinter"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.01"
        seed="0"
        velocity_scale_factor="{align_velocity_scale}"
      />
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        waypoint_name="Home"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.01"
        seed="0"
        velocity_scale_factor="{align_velocity_scale}"
      />
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        waypoint_name="Scan_Initial"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.01"
        seed="0"
        velocity_scale_factor="{align_velocity_scale}"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Sinter Raster Continuous">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Sinter" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
