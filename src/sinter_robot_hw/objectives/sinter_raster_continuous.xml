<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Sinter Raster Continuous">
  <BehaviorTree
    ID="Sinter Raster Continuous"
    _description="Continuous sintering raster for the real system (docs/continuous_tracking_plan.md). Scans the bed with the RealSense, crops and plane-fits it, and plans a zig-zag raster on the surface; seeds the lens from the ephemeris and aligns it to the sun about the focal point; checks with IK that one lens orientation reaches the whole raster; makes a planned, collision-checked lead-in to the first raster point; then switches to velocity_force_controller and runs TrackRasterWithSun, which moves the focal point along the raster at scan_speed_mps while continuously holding the lens on the sun (pauses if the sun is hidden and resumes). Switches back to the trajectory controller and retreats to BeforeSinter and Scan_Initial afterwards. On any failure during the scan it sends a zero twist, switches back and retreats. If you stop it from the UI, run Switch To Trajectory Controller before planning any other move."
    _favorite="true"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!--Planned moves need the trajectory controller; a run stopped from the UI leaves the velocity controller active. Harmless if it is already active.-->
      <SubTree ID="Switch To Trajectory Controller" _collapsed="true" />
      <!--Tunable parameters. scan_speed_mps is the scan speed V along the raster in m/s (R5: 0.5-1.5 mm/s). gain_rot (1/s) is the sun-pointing loop gain (on top of a sun-motion feedforward from latitude_deg / north_heading_deg, which removes the rate/gain lag; a 10 deg heading error barely matters to it) and gain_pos (1/s) the path-tracking gain; steady pointing lag = sun rate / gain_rot (0.004 deg/s / 0.5 = 0.008 deg). max_tracking_error_m and max_pointing_error_rad abort the scan (zero twist, retreat). sun_lost_abort_s = 0 pauses as long as the sun is hidden (clouds) and resumes when it is back. raster_size_m: the raster is a square of this side centred on the fitted plane; the crop box must land on the bed and be a little larger than the square (the fit fails if the measured surface does not cover it); 0 = fill the crop. lift_m: whenever the sun is not locked (start, clouds) and before any stop, the focus is held this far off the bed along the lens axis so the spot never dwells focused on one point. Singularity handling: dexterity is the distance from singularity (0 = singular .. 1). The roll with the best worst-point dexterity is chosen; min_roll_dexterity aborts before the lead-in if even that is too low, min_dexterity aborts the scan if the arm gets that close to a singularity, and gain_roll > 0 (try 0.05) lets the lens roll about its axis during the scan to climb away from singularities (does not move the focus or the sun alignment). outlier_distance_m drops depth points farther than that from the fitted plane (sun glare noise). settle_time_s is the pause after each move before a sun camera frame is grabbed, so the image shows the new pose (camera latency + arm vibration). north_heading_deg is the direction of true north in world, CCW from +X (125 as of 2026-11-03: world +X points ~SE at true bearing 125 deg, +Y ~NE at 35 deg. It describes how the robot base is turned relative to true north, so re-measure it whenever the robot is rotated; it does not change with the sun. Copies to keep in sync: additional_driver_nodes.launch.py (sun_ephemeris node), the Parameters scripts of sinter_raster_closed_loop.xml, sinter_raster_continuous.xml, calibrate_focus_lift.xml and sinter_dot_grid.xml, the north_heading_deg default of move_to_sun_seed_with_roll.xml, and the heading option of scripts/rs_calibration/solve.py). focus_lift_m raises the raster off the fitted plane along its normal so the focus lands on the sand (+ = up; the RealSense plane sat below the real surface, 2026-10-28). aim_offset_x_rad / aim_offset_y_rad: where the sun sits in the sun camera image (rad from center) when the lens itself is on the sun; calibrate with Calibrate Aim Offset. Set use_ephemeris_seed to false when testing with the simulated sun camera, which places the sun relative to the camera rather than the sky.-->
      <Action
        ID="Script"
        name="Parameters"
        code="line_spacing_m := 0.0025; point_spacing_m := 0.0; edge_margin_m := 0.005; outlier_distance_m := 0.005; alignment_tolerance_rad := 0.002; max_align_attempts := 8; settle_time_s := 0.3; align_velocity_scale := 0.25; use_ephemeris_seed := true; focus_lift_m := -0.045; aim_offset_x_rad := 0.0; aim_offset_y_rad := 0.0; latitude_deg := 39.7555; longitude_deg := -105.2211; north_heading_deg := 121; scan_speed_mps := 0.00075; gain_rot := 0.5; gain_pos := 1.0; max_tracking_error_m := 0.003; max_pointing_error_rad := 0.0175; sun_lost_abort_s := 0.0; raster_size_m := 0.04; min_roll_dexterity := 0.02; min_dexterity := 0.01; gain_roll := 0.0; lift_m := 0.08; lift_speed_mps := 0.003; scan_tolerance_rad := 0.005; sun_feedforward := true; sun_feedforward_scale := 1.0"
      />
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        waypoint_name="Scan_Initial"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.01"
        seed="0"
        velocity_scale_factor="1.0"
      />
      <SubTree ID="Clear Snapshot" _collapsed="true" />
      <!--RealSense D415 depth -> crop to X x Y + plane fit -> N waypoints, zig-zag raster, M spacing-->
      <Control ID="Sequence" name="Generate scanning waypoints">
        <Action
          ID="GetPointCloud"
          topic_name="/camera/camera/depth/color/points"
          message_out="{point_cloud_scan}"
          publisher_timeout_sec="5.000000"
        />
        <Action
          ID="TransformPointCloudFrame"
          input_cloud="{point_cloud_scan}"
          target_frame="world"
          output_cloud="{point_cloud_scan}"
        />
        <!--X x Y crop region on the surface (tune position/size for your setup). Z is tall so any surface height is kept.-->
        <Action
          ID="CreatePoseStamped"
          reference_frame="world"
          position_xyz="-0.55;0.00;0"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{crop_pose}"
        />
        <Action
          ID="CropPointsInBox"
          point_cloud="{point_cloud_scan}"
          crop_box_centroid_pose="{crop_pose}"
          crop_box_size="0.08;0.08;1.0"
          point_cloud_cropped="{point_cloud_cropped}"
        />
        <Action ID="SendPointCloudToUI" point_cloud="{point_cloud_cropped}" />
        <Action
          ID="FitPlaneRasterPath"
          point_cloud="{point_cloud_cropped}"
          line_spacing="{line_spacing_m}"
          point_spacing="{point_spacing_m}"
          edge_margin="{edge_margin_m}"
          outlier_distance="{outlier_distance_m}"
          surface_offset="{focus_lift_m}"
          path="{raster_path}"
          plane_pose="{plane_pose}"
          num_waypoints="{num_waypoints}"
          extremes="{raster_extremes}"
          line_subdivisions="2"
          raster_size_m="{raster_size_m}"
        />
        <Action ID="VisualizePath" path="{raster_path}" show_poses="true" />
        <Action ID="VisualizePose" pose="{plane_pose}" marker_name="plane" />
      </Control>
      <!--Begin sintering from BeforeSinter, close to the surface: the sun seed and alignment happen here, so the lead-in to the first raster point is short. Then the starting sun pose from the ephemeris model.-->
      <!--Via Home: Scan_Initial and BeforeSinter are ~180 deg apart on joint 6, and the direct move takes the short way through +/-180 deg, winding the wrist cables. Via Home both legs are under 180 deg and pass through 0.-->
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        _skipIf="true"
        waypoint_name="Home"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.01"
        seed="0"
        velocity_scale_factor="1.0"
      />
      <SubTree
        ID="Move to Waypoint"
        _collapsed="true"
        waypoint_name="BeforeSinter"
        acceleration_scale_factor="1.0"
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        controller_names="joint_trajectory_admittance_controller"
        execution_pipeline="jtac"
        joint_group_name="manipulator"
        keep_orientation="false"
        keep_orientation_tolerance="0.05"
        link_padding="0.01"
        seed="0"
        velocity_scale_factor="1.0"
      />
      <Action
        ID="WaitForDuration"
        name="WaitForDuration"
        _skipIf="true"
        delay_duration="5.000000"
      />
      <Decorator ID="Precondition" if="use_ephemeris_seed" else="SUCCESS">
        <!--Starting sun pose. The sun stays low here (under ~38 deg in late October at this latitude), so the lens tilts far over; try lens roll angles about the optical axis, nearest the current one first, and take the first that plans.-->
        <Control
          ID="Fallback"
          name="Starting sun pose (ephemeris), try lens rolls"
        >
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll 0 deg"
            _collapsed="true"
            roll_xyzw="0;0;0;1"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll 45 deg"
            _collapsed="true"
            roll_xyzw="0;0;0.382683;0.92388"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll -45 deg"
            _collapsed="true"
            roll_xyzw="0;0;-0.382683;0.92388"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll 90 deg"
            _collapsed="true"
            roll_xyzw="0;0;0.707107;0.707107"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll -90 deg"
            _collapsed="true"
            roll_xyzw="0;0;-0.707107;0.707107"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll 135 deg"
            _collapsed="true"
            roll_xyzw="0;0;0.92388;0.382683"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll -135 deg"
            _collapsed="true"
            roll_xyzw="0;0;-0.92388;0.382683"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
          <SubTree
            ID="Move To Sun Seed With Roll"
            name="Roll 180 deg"
            _collapsed="true"
            roll_xyzw="0;0;1;0"
            latitude_deg="{latitude_deg}"
            longitude_deg="{longitude_deg}"
            north_heading_deg="{north_heading_deg}"
            velocity_scale_factor="{align_velocity_scale}"
          />
        </Control>
      </Decorator>
      <!--Rotate lens to align to sun about focal point; alignment error < tolerance, or abort-->
      <SubTree
        ID="Align Lens To Sun"
        _collapsed="true"
        alignment_tolerance_rad="{alignment_tolerance_rad}"
        max_align_attempts="{max_align_attempts}"
        velocity_scale_factor="{align_velocity_scale}"
        settle_time_s="{settle_time_s}"
        aim_offset_x_rad="{aim_offset_x_rad}"
        aim_offset_y_rad="{aim_offset_y_rad}"
        aligned_focal_pose="{aligned_focal_pose}"
      />
      <!--BEGIN GENERATED: roll selection + lead-in (scripts/tracking/gen_continuous_objectives.py)-->
      <!--Check points for every roll: the raster extremes AND the same points lifted lift_m along the lens axis (the tracker lifts there while acquiring, during clouds and before stopping). The lens axis is the aligned one, the same for every roll.-->
      <Action
        ID="UnpackPoseStampedMessage"
        pose_stamped="{aligned_focal_pose}"
        pose="{aligned_focal_msg}"
      />
      <Action
        ID="UnpackPoseMessage"
        pose="{aligned_focal_msg}"
        orientation="{aligned_orientation}"
      />
      <Action
        ID="OffsetPosesAlongAxis"
        poses="{raster_extremes}"
        axis_orientation="{aligned_orientation}"
        distance="{lift_m}"
        include_original="true"
        first_only="false"
        poses_out="{raster_check_points}"
        first_out="{unused_pose}"
      />
      <Action
        ID="GetCurrentPlanningScene"
        planning_scene_msg="{planning_scene}"
      />
      <!--The roll score below rehearses a scan with the roll HELD; gain_roll > 0 lets the tracker roll away from that configuration.-->
      <Decorator ID="Precondition" if="gain_roll &gt; 0.0" else="SUCCESS">
        <Action
          ID="LogMessage"
          message="gain_roll &gt; 0: the tracker will roll the lens during the scan, so the roll selection's simulated scan (roll held) is not what runs. Keep gain_roll 0 unless testing roll."
          log_level="warn"
        />
      </Decorator>
      <Control
        ID="Sequence"
        name="Pick the lens roll whose simulated scan stays farthest from a singularity"
      >
        <!--Per roll (nearest the current roll first): IK + collisions at the check points (cheap prefilter); IK (with collisions) at the LIFTED start = the scan seed; SimulateRasterScan rehearses descend -> raster -> lift from that seed with the controller's damped least squares and the sun-turning orientation (fails on missed targets, joint limits or joint speed) and its trajectory is collision-checked (ValidateTrajectory); the score is the worst dexterity along that simulated scan, i.e. of the configuration that will actually run. A farther roll must be 25 % better (KeepBestRoll). The best seed is the lead-in target.-->
        <Action ID="Script" code="best_dexterity := -1.0" />
        <Decorator ID="ForceSuccess" name="Roll 0 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_check_points}"
              roll_xyzw="0;0;0;1"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_point_dexterity}"
            />
            <Action
              ID="OffsetPosesAlongAxis"
              poses="{raster_path}"
              axis_orientation="{cand_orientation}"
              distance="{lift_m}"
              include_original="false"
              first_only="true"
              poses_out="{cand_lifted_start}"
              first_out="{cand_lifted_start_pose}"
            />
            <Action
              ID="ComputeInverseKinematics"
              target_poses="{cand_lifted_start}"
              tip_links="ee_focal_point_link"
              planning_scene_msg="{planning_scene}"
              planning_group_name="manipulator"
              ik_timeout_s="0.2"
              link_padding="0.01"
              solution="{cand_seed}"
            />
            <Action
              ID="SimulateRasterScan"
              seed_joint_state="{cand_seed}"
              path="{raster_path}"
              orientation="{cand_orientation}"
              lift_m="{lift_m}"
              scan_speed_mps="{scan_speed_mps}"
              lift_speed_mps="{lift_speed_mps}"
              step_m="0.002"
              damping="0.005"
              max_residual_m="0.0005"
              max_joint_speed_rps="0.3"
              acquire_margin_s="30.0"
              sun_feedforward="{sun_feedforward}"
              latitude_deg="{latitude_deg}"
              north_heading_deg="{north_heading_deg}"
              sun_feedforward_scale="{sun_feedforward_scale}"
              planning_group="manipulator"
              tip_link="ee_focal_point_link"
              dexterity_length_m="0.4"
              min_dexterity="{cand_dexterity}"
              trajectory="{cand_trajectory}"
            />
            <Action
              ID="ValidateTrajectory"
              planning_scene_msg="{planning_scene}"
              planning_group_name="manipulator"
              joint_trajectory_msg="{cand_trajectory}"
              joint_space_step="0.05"
              cartesian_space_step="0.02"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_joint_state="{cand_seed}"
              require_joint_state="true"
              candidate_name="roll 0 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_joint_state="{best_scan_seed}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="ForceSuccess" name="Roll 45 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_check_points}"
              roll_xyzw="0;0;0.382683;0.92388"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_point_dexterity}"
            />
            <Action
              ID="OffsetPosesAlongAxis"
              poses="{raster_path}"
              axis_orientation="{cand_orientation}"
              distance="{lift_m}"
              include_original="false"
              first_only="true"
              poses_out="{cand_lifted_start}"
              first_out="{cand_lifted_start_pose}"
            />
            <Action
              ID="ComputeInverseKinematics"
              target_poses="{cand_lifted_start}"
              tip_links="ee_focal_point_link"
              planning_scene_msg="{planning_scene}"
              planning_group_name="manipulator"
              ik_timeout_s="0.2"
              link_padding="0.01"
              solution="{cand_seed}"
            />
            <Action
              ID="SimulateRasterScan"
              seed_joint_state="{cand_seed}"
              path="{raster_path}"
              orientation="{cand_orientation}"
              lift_m="{lift_m}"
              scan_speed_mps="{scan_speed_mps}"
              lift_speed_mps="{lift_speed_mps}"
              step_m="0.002"
              damping="0.005"
              max_residual_m="0.0005"
              max_joint_speed_rps="0.3"
              acquire_margin_s="30.0"
              sun_feedforward="{sun_feedforward}"
              latitude_deg="{latitude_deg}"
              north_heading_deg="{north_heading_deg}"
              sun_feedforward_scale="{sun_feedforward_scale}"
              planning_group="manipulator"
              tip_link="ee_focal_point_link"
              dexterity_length_m="0.4"
              min_dexterity="{cand_dexterity}"
              trajectory="{cand_trajectory}"
            />
            <Action
              ID="ValidateTrajectory"
              planning_scene_msg="{planning_scene}"
              planning_group_name="manipulator"
              joint_trajectory_msg="{cand_trajectory}"
              joint_space_step="0.05"
              cartesian_space_step="0.02"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_joint_state="{cand_seed}"
              require_joint_state="true"
              candidate_name="roll 45 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_joint_state="{best_scan_seed}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="ForceSuccess" name="Roll -45 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_check_points}"
              roll_xyzw="0;0;-0.382683;0.92388"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_point_dexterity}"
            />
            <Action
              ID="OffsetPosesAlongAxis"
              poses="{raster_path}"
              axis_orientation="{cand_orientation}"
              distance="{lift_m}"
              include_original="false"
              first_only="true"
              poses_out="{cand_lifted_start}"
              first_out="{cand_lifted_start_pose}"
            />
            <Action
              ID="ComputeInverseKinematics"
              target_poses="{cand_lifted_start}"
              tip_links="ee_focal_point_link"
              planning_scene_msg="{planning_scene}"
              planning_group_name="manipulator"
              ik_timeout_s="0.2"
              link_padding="0.01"
              solution="{cand_seed}"
            />
            <Action
              ID="SimulateRasterScan"
              seed_joint_state="{cand_seed}"
              path="{raster_path}"
              orientation="{cand_orientation}"
              lift_m="{lift_m}"
              scan_speed_mps="{scan_speed_mps}"
              lift_speed_mps="{lift_speed_mps}"
              step_m="0.002"
              damping="0.005"
              max_residual_m="0.0005"
              max_joint_speed_rps="0.3"
              acquire_margin_s="30.0"
              sun_feedforward="{sun_feedforward}"
              latitude_deg="{latitude_deg}"
              north_heading_deg="{north_heading_deg}"
              sun_feedforward_scale="{sun_feedforward_scale}"
              planning_group="manipulator"
              tip_link="ee_focal_point_link"
              dexterity_length_m="0.4"
              min_dexterity="{cand_dexterity}"
              trajectory="{cand_trajectory}"
            />
            <Action
              ID="ValidateTrajectory"
              planning_scene_msg="{planning_scene}"
              planning_group_name="manipulator"
              joint_trajectory_msg="{cand_trajectory}"
              joint_space_step="0.05"
              cartesian_space_step="0.02"
            />
            <Action
              ID="KeepBestRoll"
              candidate_score="{cand_dexterity}"
              candidate_orientation="{cand_orientation}"
              candidate_joint_state="{cand_seed}"
              require_joint_state="true"
              candidate_name="roll -45 deg"
              best_score_in="{best_dexterity}"
              best_score_out="{best_dexterity}"
              best_orientation="{sun_orientation}"
              best_joint_state="{best_scan_seed}"
              best_name="{best_roll_name}"
            />
          </Control>
        </Decorator>
        <Decorator ID="ForceSuccess" name="Roll 90 deg">
          <Control ID="Sequence">
            <SubTree
              ID="Raster Reachable With Roll"
              _collapsed="true"
              raster_path="{raster_check_points}"
              roll_xyzw="0;0;0.707107;0.707107"
              planning_scene_msg="{planning_scene}"
              rolled_orientation="{cand_orientation}"
              min_dexterity="{cand_point_dexterity}"
            />
            <Action
              ID="OffsetPosesAlongAxis"
              poses="{raster_path}"
              axis_orientation="{cand_orientation}"
              distance="{lift_m}"
              include_original="false"
              first_only="true"
              poses_out="{cand_lifted_start}"
              first_out="{cand_lifted_start_pose}"
            />
            <Action
              ID="ComputeInverseKinematics"
              target_poses="{cand_lifted_start}"
              tip_links="ee_focal_point_link"
              planning_scene_msg="{planning_scene}"
              planning_group_name="manipulator"
              ik_timeout_s="0.2"
              link_padding="0.01"
              solution="{cand_seed}"
            />
            <Action
              ID="SimulateRasterScan"
              seed_joint_state="{cand_seed}"
              path="{raster_path}"
              orientation="{cand_orientation}"
              lift_m="{lift_m}"
              scan_speed_mps="{scan_speed_mps}"
              lift_speed_mps="{lift_speed_mps}"
              step_m="0.002"
              damping="0.005"
              max_residual_m="0.0005"
              max_joint_speed_rps="0.3"
              acquire_margin_s="30.0"
              sun_feedforward="{sun_feedforward}"
              latitude_deg="{latitude_deg}"
              north_heading_deg="{north_heading_deg}"
              sun_feedforward_scale="{sun_feedforward_scale}"
              planning_group="manipulator"
              tip_link="ee_focal_point_link"
              dexterity_length_m="0.4"
              min_dexterity="{cand_dexterity}"
              trajectory="{cand_trajectory}"
            />
            <Action
              ID="ValidateTrajectory"
