<?xml version="1.0" ?>
<package format="3">
  <name>sinter_robot_hw</name>
  <version>0.0.1</version>
  <description>Hardware implementation of the space sinter robot</description>

  <maintainer email="cameronhinkle@mines.edu">
    Cameron Hinkle
  </maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>sinter_robot_mock</depend>
  <depend>camera_ros</depend>
  <depend>tf2_ros</depend>
  <exec_depend>srrl_irradiance</exec_depend>
  <exec_depend>sun_pose_finder</exec_depend>
  <!-- Message type of /events/write_split from scripts/record_trial.sh; without it the UI's web_bridge logs an error
       twice a second while recording. -->
  <exec_depend>rosbag2_interfaces</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
